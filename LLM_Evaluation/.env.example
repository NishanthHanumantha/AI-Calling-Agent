# LLM-EVAL.1.1 — copy names only. Do not commit real keys.

# Sarvam (same key used by both slots)
SARVAM_API_KEY=
SARVAM_CONVERSATIONAL_MODEL=sarvam-105b-conversations
SARVAM_FLAGSHIP_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai/v1/chat/completions

# DeepSeek V4.1 Flash — interactive lab only (LLM-EVAL.2.2). Not used by production.
DEEPSEEK_API_KEY=
DEEPSEEK_FLAGSHIP_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING_MODE=disabled

# Claude / Anthropic (same key used by both slots)
ANTHROPIC_API_KEY=
CLAUDE_FLAGSHIP_MODEL=claude-opus-4-8
CLAUDE_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# Optional LLM-as-a-judge (leave empty to skip semantic scoring)
JUDGE_API_KEY=
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_PROVIDER=

# Qwen is OUT OF SCOPE for LLM-EVAL.1.1 and is disabled in config/models.yaml.
